# Окружение: development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL (asyncpg)
DATABASE_URL=postgresql+asyncpg://nftscanner:nftscanner@localhost:5432/nftscanner

# Секреты. В production обязательно заменить, значения по умолчанию там не принимаются.
JWT_SECRET=change-me
TELEGRAM_BOT_TOKEN=

# CORS: адреса фронтенда через запятую
CORS_ORIGINS=http://localhost:3000

# Режим источника данных сканера: demo | real
SCANNER_MODE=demo
